## .gitignore for .NET and Docker

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# Rider
.idea/
*.sln.iml

# User-specific files
*.rsuser
*.suo
*.user
*.userprefs

# Database & Volume files
pgdata/
*.db
*.sqlite

# OS generated files
.DS_Store
Thumbs.db

# Docker
.docker/

# Environment files với thông tin nhạy cảm (không commit lên Git)
.env
# Ngoại lệ: Cho phép commit file mẫu .env.example
!.env.example
