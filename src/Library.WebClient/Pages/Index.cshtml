@page
@model IndexModel
@{
    ViewData["Title"] = "Tra Cứu Sách";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold"><i class="bi bi-journals text-primary me-2"></i>Kho Sách Thư Viện</h2>
        <p class="text-muted">Tra cứu số lượng sách khả dụng và gửi yêu cầu đặt mượn bất đồng bộ.</p>
    </div>
    <div class="col-md-4 text-md-end align-self-center">
        <a asp-page="/Reservations" class="btn btn-outline-primary">
            <i class="bi bi-clock-history me-1"></i>Xem danh sách đặt mượn
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.AlertMessage))
{
    <div class="alert alert-@Model.AlertType alert-dismissible fade show" role="alert">
        <i class="bi bi-info-circle-fill me-2"></i>@Model.AlertMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search & Filter Bar -->
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" name="SearchTerm" value="@Model.SearchTerm" placeholder="Tìm theo tên sách, tác giả..." />
                </div>
            </div>
            <div class="col-md-4">
                <select class="form-select" name="SelectedCategory">
                    <option value="">-- Tất cả thể loại --</option>
                    <option value="Distributed Systems" selected="@(Model.SelectedCategory == "Distributed Systems")">Distributed Systems</option>
                    <option value="Software Engineering" selected="@(Model.SelectedCategory == "Software Engineering")">Software Engineering</option>
                    <option value="Architecture" selected="@(Model.SelectedCategory == "Architecture")">Architecture</option>
                    <option value="Database" selected="@(Model.SelectedCategory == "Database")">Database</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Lọc Sách</button>
            </div>
        </form>
    </div>
</div>

<!-- Book List Table / Cards -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 35%;">Tên Sách</th>
                    <th scope="col">Tác Giả</th>
                    <th scope="col">Thể Loại</th>
                    <th scope="col" class="text-center">Số Bản Khả Dụng</th>
                    <th scope="col" class="text-end" style="width: 20%;">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Books.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>Không tìm thấy cuốn sách nào phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var book in Model.Books)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@book.Title</div>
                                <small class="text-muted">ISBN: @(book.Isbn ?? "N/A")</small>
                            </td>
                            <td>@book.Author</td>
                            <td><span class="badge bg-secondary">@book.Category</span></td>
                            <td class="text-center">
                                @if (book.AvailableCopies > 0)
                                {
                                    <span class="badge bg-success fs-6 px-3 py-2">
                                        @book.AvailableCopies / @book.TotalCopies bản
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger fs-6 px-3 py-2">
                                        0 / @book.TotalCopies bản (Hết sách)
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-success" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#reserveModal" 
                                        data-book-id="@book.Id" 
                                        data-book-title="@book.Title">
                                    <i class="bi bi-bookmark-plus me-1"></i>Đặt Mượn
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Đặt Mượn Sách -->
<div class="modal fade" id="reserveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Reserve">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-bookmark-check text-success me-2"></i>Xác Nhận Đặt Mượn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="bookId" id="modalBookId" />

                    <div class="mb-3">
                        <label class="form-label text-muted">Cuốn sách đã chọn:</label>
                        <div id="modalBookTitle" class="fw-bold text-primary fs-6"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Chọn Độc Giả (Mô phỏng):</label>
                        <select class="form-select" name="userId" required>
                            <option value="11111111-1111-1111-1111-111111111111">Nguyễn Văn An (B22DCCN001)</option>
                            <option value="22222222-2222-2222-2222-222222222222">Trần Thị Bình (B22DCCN002)</option>
                        </select>
                        <small class="form-text text-muted">
                            Yêu cầu sẽ được đưa vào hàng đợi RabbitMQ và xử lý kiểm tra số lượng khả dụng bất đồng bộ.
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success"><i class="bi bi-send me-1"></i>Gửi Yêu Cầu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var reserveModal = document.getElementById('reserveModal');
        reserveModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var bookId = button.getAttribute('data-book-id');
            var bookTitle = button.getAttribute('data-book-title');

            document.getElementById('modalBookId').value = bookId;
            document.getElementById('modalBookTitle').innerText = bookTitle;
        });
    </script>
}
