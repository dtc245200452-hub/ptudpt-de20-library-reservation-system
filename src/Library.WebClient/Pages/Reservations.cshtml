@page
@model ReservationsModel
@{
    ViewData["Title"] = "Quản Lý Đặt Mượn";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold"><i class="bi bi-card-checklist text-primary me-2"></i>Quản Lý & Theo Dõi Đặt Mượn</h2>
        <p class="text-muted">Theo dõi tiến trình xử lý bất đồng bộ từ RabbitMQ và cập nhật vòng đời mượn - trả sách.</p>
    </div>
    <div class="col-md-4 text-md-end align-self-center">
        <a asp-page="/Reservations" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-clockwise me-1"></i>Làm Mới (Refresh)
        </a>
        <a asp-page="/Index" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Đặt Mượn Thêm
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.AlertMessage))
{
    <div class="alert alert-@Model.AlertType alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.AlertMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Mã Yêu Cầu</th>
                    <th scope="col">Tên Sách</th>
                    <th scope="col">Độc Giả</th>
                    <th scope="col" class="text-center">Trạng Thái</th>
                    <th scope="col">Mốc Thời Gian / Chi Tiết</th>
                    <th scope="col" class="text-end">Thao Tác Thủ Thư</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Reservations.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>Chưa có yêu cầu đặt mượn nào. Hãy sang trang Tra Cứu Sách để tạo yêu cầu!
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Reservations)
                    {
                        <tr>
                            <td>
                                <code>@item.Id.ToString()[..8]...</code>
                                <div class="small text-muted">@item.CreatedAt.ToLocalTime().ToString("HH:mm:ss dd/MM")</div>
                            </td>
                            <td>
                                <div class="fw-bold">@item.BookTitle</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.UserName</span>
                            </td>
                            <td class="text-center">
                                @switch (item.Status)
                                {
                                    case Library.Contracts.Enums.ReservationStatus.Pending:
                                        <span class="badge badge-pending px-2 py-1"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                        break;
                                    case Library.Contracts.Enums.ReservationStatus.Reserved:
                                        <span class="badge badge-reserved px-2 py-1"><i class="bi bi-check2-circle me-1"></i>Reserved</span>
                                        break;
                                    case Library.Contracts.Enums.ReservationStatus.Rejected:
                                        <span class="badge badge-rejected px-2 py-1"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                                        break;
                                    case Library.Contracts.Enums.ReservationStatus.Borrowed:
                                        <span class="badge badge-borrowed px-2 py-1"><i class="bi bi-box-arrow-right me-1"></i>Borrowed</span>
                                        break;
                                    case Library.Contracts.Enums.ReservationStatus.Returned:
                                        <span class="badge badge-returned px-2 py-1"><i class="bi bi-arrow-return-left me-1"></i>Returned</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (item.Status == Library.Contracts.Enums.ReservationStatus.Rejected)
                                {
                                    <div class="text-danger small"><i class="bi bi-exclamation-triangle me-1"></i>@(item.RejectReason ?? "Hết sách khả dụng")</div>
                                }
                                else if (item.Status == Library.Contracts.Enums.ReservationStatus.Pending)
                                {
                                    <div class="text-warning small"><i class="bi bi-arrow-repeat me-1"></i>Đang trong hàng đợi RabbitMQ...</div>
                                }
                                else if (item.Status == Library.Contracts.Enums.ReservationStatus.Reserved)
                                {
                                    <div class="text-success small">Xử lý lúc: @item.ProcessedAt?.ToLocalTime().ToString("HH:mm:ss")</div>
                                }
                                else if (item.Status == Library.Contracts.Enums.ReservationStatus.Borrowed)
                                {
                                    <div class="text-primary small">Mượn lúc: @item.BorrowedAt?.ToLocalTime().ToString("HH:mm:ss")</div>
                                }
                                else if (item.Status == Library.Contracts.Enums.ReservationStatus.Returned)
                                {
                                    <div class="text-muted small">Trả lúc: @item.ReturnedAt?.ToLocalTime().ToString("HH:mm:ss")</div>
                                }
                            </td>
                            <td class="text-end">
                                @if (item.Status == Library.Contracts.Enums.ReservationStatus.Reserved)
                                {
                                    <form method="post" asp-page-handler="Borrow" asp-route-id="@item.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-primary">
                                            <i class="bi bi-box-arrow-right me-1"></i>Giao Sách
                                        </button>
                                    </form>
                                }
                                else if (item.Status == Library.Contracts.Enums.ReservationStatus.Borrowed)
                                {
                                    <form method="post" asp-page-handler="Return" asp-route-id="@item.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-secondary">
                                            <i class="bi bi-arrow-return-left me-1"></i>Nhận Trả Sách
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
